import httpClient from '@/services/api/httpClient'
import { API_ENDPOINTS } from '@/constants/apiEndpoints'

/**
 * Customer Support API service.
 *
 * Backend customer endpoints:
 * POST /support
 * GET  /support/my-tickets
 * GET  /support/my-tickets/:ticketId
 * GET  /support/my-tickets/:ticketId/messages
 * POST /support/my-tickets/:ticketId/messages
 */
export const supportService = {
  async getSupportContent() {
    return httpClient.get(API_ENDPOINTS.CONTENT.SUPPORT)
  },

  async submitInquiry(payload) {
    return httpClient.post(API_ENDPOINTS.CONTENT.SUPPORT, payload)
  },

  async getTickets() {
    const response = await httpClient.get('/support/my-tickets')

    const data = response?.data?.data ?? response?.data ?? {}

    return {
      ...response,
      data: {
        tickets: data.items ?? [],
        pagination: data.pagination ?? null,
      },
    }
  },

  async getTicketDetails(id) {
    const response = await httpClient.get(`/support/my-tickets/${id}`)

    const ticket = response?.data?.data ?? response?.data ?? {}

    const messagesResponse = await httpClient.get(`/support/my-tickets/${id}/messages`)

    const messagesPayload = messagesResponse?.data?.data ?? messagesResponse?.data ?? []

    const messages = Array.isArray(messagesPayload)
      ? messagesPayload
      : Array.isArray(messagesPayload?.items)
        ? messagesPayload.items
        : Array.isArray(messagesPayload?.messages)
          ? messagesPayload.messages
          : []

    return {
      ...response,
      data: {
        ...ticket,
        messages,
      },
    }
  },

  async createTicket(payload) {
    return httpClient.post('/support', payload)
  },

  async replyToTicket(id, payload) {
    return httpClient.post(`/support/my-tickets/${id}/messages`, payload)
  },

  async getFaqs() {
    return Promise.resolve({ data: { faqs: [] } })
  },
}

export default supportService
