import httpClient from '@/services/api/httpClient'

function unwrap(response) {
  return response?.data?.data ?? response?.data ?? response
}

export const walletService = {
  async getBalance() {
    const response = await httpClient.get('/wallet')
    const payload = unwrap(response)
    const wallet = payload?.wallet ?? payload ?? {}

    return {
      balance: Number(wallet.balance ?? 0),
      currency: wallet.currencyCode ?? wallet.currency ?? 'INR',
    }
  },

  async getTransactions(params = {}) {
    const response = await httpClient.get('/wallet/transactions', {
      params,
    })

    const payload = unwrap(response)

    return {
      transactions: payload?.items ?? [],
      meta: response?.data?.meta ?? payload?.meta ?? null,
    }
  },

  async getRefunds() {
    return {
      refunds: [],
    }
  },

  async recharge() {
    throw new Error(
      'Add Money will be enabled after Razorpay wallet top-up integration.'
    )
  },
}

export default walletService
