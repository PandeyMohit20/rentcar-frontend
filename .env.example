# ── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=RentCar
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# ── API ──────────────────────────────────────────────────────────────────────
# Base URL for the backend API (production backend).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── React Query ──────────────────────────────────────────────────────────────
# Default stale time for queries (in milliseconds).
VITE_QUERY_STALE_TIME=60000
# Default retry count for failed queries.
VITE_QUERY_RETRY_COUNT=2

# ── Features ─────────────────────────────────────────────────────────────────
# Toggle features during development (true/false).
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_REDUX_DEVTOOLS=true

# ── Authentication ───────────────────────────────────────────────────────────
# Persist storage key used by redux-persist.
VITE_PERSIST_KEY=rentcar-root
# Persist storage type (localStorage | sessionStorage).
VITE_PERSIST_STORAGE=localStorage
